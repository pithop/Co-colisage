# ==============================================================================
# BagVoyage Environment Variables Template
# Copy to `.env` or `.env.production` for custom deployment configuration.
# ==============================================================================

# Public Web Application Base URL
VITE_APP_URL=https://bagvoyage.app

# Optional Remote Cloud API Backend URL
# Leave empty for 100% standalone offline-first local mode (BagVoyageDB_v2 IndexedDB)
# Or point to your backend: e.g. https://api.bagvoyage.app or http://localhost:8080
VITE_API_URL=

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Stripe Connect Publishable Key (Escrow & Payments)
# Obtain from Stripe Dashboard -> Developers -> API keys (pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Flight & Maritime Live Radar Refresh Interval (in milliseconds)
VITE_RADAR_REFRESH_INTERVAL=15000

# Port for preview server
PORT=3000
